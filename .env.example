# Copie para .env e ajuste os valores para sua máquina.
# Os scripts npm não leem .env automaticamente; use:
#   node --env-file=.env server/index.ts
# ou defina as variáveis no shell antes de npm start.
PORT=3001
ORGANIZE_DATA_DIR=server/data
ORGANIZE_DB_PATH=server/data/organize.sqlite
ORGANIZE_DIST_DIR=dist
NODE_ENV=development
# Opcional: HTTPS local para abrir e instalar a PWA pelo celular.
# Use caminhos para certificado e chave válidos para o IP/nome acessado pelo telefone.
# ORGANIZE_TLS_CERT_PATH=C:\caminho\organize-local.pem
# ORGANIZE_TLS_KEY_PATH=C:\caminho\organize-local-key.pem
